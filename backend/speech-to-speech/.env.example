# Opt-in scene perception. Standard clients receive no extension events.
REACHY_DIARIZATION=0
NEMO_DIAR_GPU=0
# Set absolute paths to the independently installed C ABI library and pinned Q8 artifact.
NEMO_DIAR_LIBRARY=
NEMO_DIAR_MODEL=
# Automatic gaze is a separate Reachy Presence client option, disabled by default.
